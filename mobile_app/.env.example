# Copy this file to `.env` in the same folder (mobile_app/).
# `.env` is gitignored; it is bundled as a Flutter asset for release builds.

# Primary API base (no trailing slash). AppConfig also reads BASE_URL if set.
APP_API_URL=https://orderzhouse-backend.onrender.com

# Optional: use instead of APP_API_URL
# BASE_URL=https://orderzhouse-backend.onrender.com

# production | development (development defaults to http://10.0.2.2:5050 on Android emulator if no URL set)
ENV=production

# Local backend (iOS simulator: http://127.0.0.1:5050 — Android emulator: http://10.0.2.2:5050)
# APP_API_URL=http://127.0.0.1:5050

# Optional: company subscription survey (see AppConfig.companySubscribeUrl)
# COMPANY_SUBSCRIBE_URL=https://example.com/survey
