# Copy to `.env` in this folder (`mobile_app/`). `.env` is gitignored.
#
# Security: `.env` is bundled as a Flutter asset in release builds. Do NOT put API
# secrets, private keys, or admin tokens here — only public URLs and non-secret flags.

# ========== PRODUCTION (Render) — default ==========
APP_API_URL=https://orderzhouse-backend.onrender.com
ENV=production

# ========== LOCAL BACKEND (comment the two lines above, use these) ==========
# iOS Simulator / Mac:
# APP_API_URL=http://127.0.0.1:5050
# ENV=development
# Android Emulator:
# APP_API_URL=http://10.0.2.2:5050
# ENV=development
# Physical phone (same Wi‑Fi as dev machine):
# APP_API_URL=http://192.168.x.x:5050
# ENV=development

# Optional: use instead of APP_API_URL
# BASE_URL=https://orderzhouse-backend.onrender.com

# Optional: company subscription survey
# COMPANY_SUBSCRIBE_URL=https://example.com/survey
