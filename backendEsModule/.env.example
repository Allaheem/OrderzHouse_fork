PORT=5000
NODE_ENV=production
APP_API_URL=https://your-api-domain.com
TEST_PORT=3001

# Database
DB_URL=postgresql://username:password@host:5432/database_name
DB_SSL=true

# Authentication & Security
SECRET=replace_with_random_number_or_phrase
JWT_SECRET=replace_with_strong_jwt_secret
ADMIN_COOKIE_SECRET=replace_with_strong_cookie_secret

# Google / OAuth
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Cloud & Image Services
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# OTP & Email
OTP_SECRET=replace_with_strong_otp_secret
EMAIL_FROM=no-reply@your-domain.com
RESEND_API_KEY=re_replace_with_resend_api_key

# SMS / Twilio
TWILIO_ACCOUNT_SID=AC_replace_with_twilio_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE_NUMBER=

# Third-Party APIs
EMAIL_API_KEY=replace_with_email_provider_key

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_replace_me
CLIENT_URL=https://your-frontend-domain.com
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret
