# Copy to `.env` in `frontend/` (gitignored). Vite exposes only `VITE_*` to the client.

# API base (optional — auto-detected from hostname when unset)
# VITE_APP_API_URL=http://localhost:5050

# Freelancer account verification booking (opens in new tab from Plans page). Falls back to VITE_COMPANY_SUBSCRIBE_URL then a default survey URL.
# VITE_FREELANCER_VERIFY_BOOKING_URL=https://example.com/book-verification

# Company subscription / survey (legacy fallback)
# VITE_COMPANY_SUBSCRIBE_URL=https://appointments.battechno.com/survey
